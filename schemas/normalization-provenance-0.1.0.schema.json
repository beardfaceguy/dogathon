{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dogathon.local/schemas/normalization-provenance-0.1.0.json",
  "title": "Dogathon Normalization Provenance",
  "type": "object",
  "required": ["rulesetVersion", "profile"],
  "properties": {
    "rulesetVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["id", "revision", "digest"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
