{
  "name": "dogathon-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "tsx src/seed.ts",
    "dev": "tsx watch src/server.ts",
    "demo:intake": "tsx src/intake/demo-server.ts",
    "start": "tsx src/server.ts",
    "reset": "tsx src/reset.ts",
    "evaluate:intake": "tsx src/intake/evaluate.ts",
    "lint": "biome lint src scripts e2e playwright.config.ts",
    "normalize:intake": "tsx src/intake/cli.ts",
    "check": "npm run lint && npm run typecheck && npm run test:layout && npm test",
    "test": "tsx scripts/run-tests.ts",
    "test:browser": "playwright test",
    "test:layout": "tsx scripts/check-test-layout.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@arcadeai/arcadejs": "^2.4.1",
    "@hono/node-server": "^2.1.1",
    "@mastra/core": "^1.61.0",
    "@mastra/mcp": "^1.17.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
